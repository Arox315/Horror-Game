[sub_resource type="GDScript" id="GDScript_4y8jm"]
script/source = "extends Area3D


@export var retrigger_cooldown: float = 1.0

var elapsed: float = 0.0
func _physics_process(delta: float) -> void:
	if not multiplayer.is_server(): return
	elapsed += delta
	if elapsed >= retrigger_cooldown:
		for body in get_overlapping_bodies():
			ServerRequests.send_remove_effect_request(body, EffectsTable.Effects.ACCELERATING_MOVE_SPEED)
			#if body.has_node(\"EffectsComponent\") and body.is_multiplayer_authority():
				#body.get_node(\"EffectsComponent\").remove_effect(EffectsTable.Effects.ACCELERATING_MOVE_SPEED)
		elapsed = 0.0
"


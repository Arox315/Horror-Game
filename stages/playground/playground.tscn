[sub_resource type="GDScript" id="GDScript_35kbn"]
script/source = "extends Area3D

@export var retrigger_cooldown: float = 1.0

var c := true
var elapsed: float = -5.0
func _physics_process(delta: float) -> void:
	if not multiplayer.is_server(): return
	if get_tree().get_nodes_in_group(\"Players\").is_empty(): return
	if not c: return
	elapsed += delta
	if elapsed >= retrigger_cooldown:
		for body in get_overlapping_bodies():
			ServerRequests.send_add_effect_request(body, EffectsTable.Effects.BONUS_JUMP_HEIGHT)
		elapsed = 0.0
		c = false


#func _on_body_entered(body: Node3D) -> void:
	#if body.has_node(\"EffectsComponent\"):
		#elapsed = 0.0
		#body.get_node(\"EffectsComponent\").add_effect.rpc(EffectsTable.Effects.BONUS_JUMP_HEIGHT)
"

